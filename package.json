{
  "name": "bounty_builder",
  "version": "0.1.0",
  "private": true,
  "author": "Joao Linhares",
  "description": "The ultimate builder for One Piece Bounty Rush. Optimize your gameplay by creating custom medal sets, managing character builds, and theorycrafting the perfect party.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "tailwindcss",
    "opbr",
    "shadcn",
    "prisma"
  ],
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:wait": "wait-on tcp:5432",
    "dev": "npm run docker:up && npm run docker:wait && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "hono": "^4.11.9",
    "lodash": "^4.17.23",
    "ajv": "^8.18.0",
    "minimatch": "^10.2.1",
    "glob": "^11.0.0",
    "rimraf": "^6.0.0"
  }

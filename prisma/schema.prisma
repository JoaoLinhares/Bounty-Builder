// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------------------------------
/**
 * Enums:
 * - Elements
 * - Classes
 * - Types
 * - Sizes
 * - Base Grades
 * - FourStarTypes
 * - Team Boosts
 * - Medal Types
 */
// ------------------------------------------------------------------------------------- 

enum Element {
  RED
  BLUE
  GREEN
  DARK
  LIGHT
}

enum Class {
  ATTACKER
  DEFENDER
  RUNNER
}

enum Size {
  NORMAL
  SMALL
  GIANT
}

enum BaseGrade {
  TWO_STAR
  THREE_STAR
  FOUR_STAR
}

enum FourStarType {
  STEP_UP
  BOUNTY_FEST
  EXTREME
  COLA
}

enum TeamBoost {
  ATTACK
  EX_ATTACK
  RECOVERY
  EX_RECOVERY
  SPD
  EX_SPD
}

enum MedalType {
  CHARACTER
  CHARACTER_RANKING
  EVENT
}

// -------------------------------------------------------------------------------------
/**
 * User only avaiable information datatables
 */
// ------------------------------------------------------------------------------------- 

// -------------------------------------------------------------------------------------
/**
 * Model User
 * Contains essencial information for login/register use cases.
 * Also contains information for:
 * - characters owned and their current status (current level, current grade level, skill levels and boost status)
 * - medals owned and medal traits applied
 * - medal sets created
 * - party sets created
 */

// ------------------------------------------------------------------------------------- 

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters UserCharacter[]
  medals     UserMedal[]

  medalSets MedalSet[]
  parties   Party[]
}

// -------------------------------------------------------------------------------------
/**
 * Model UserCharacter
 * Contains information specific to the user about his character like:
 * - current level
 * - current cap level
 * - current boost
 * - skill 1 and skill 2 current level
 */

// ------------------------------------------------------------------------------------- 
model UserCharacter {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  level    Int @default(1)
  levelCap Int

  currentBoost Int @default(0)

  skill1Level Int @default(1)
  skill2Level Int @default(1)

  medalSets          MedalSetCharacter[]
  parties            SupportCharacter[]
  playableCharacters PlayableCharacter[]

  isOwned Boolean @default(true)

  @@unique([userId, characterId])
  @@index([userId, isOwned])
}

// -------------------------------------------------------------------------------------
/**
 * Model Party
 * Contains information specific to the user about his party including:
 * - name
 * - characters
 * - isComplete: If set is already owned or if there are things missing in the set like a medal or a medal trait
 */

// ------------------------------------------------------------------------------------- 
model Party {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  support SupportCharacter[]

  playableCharacters PlayableCharacter[]

  isComplete Boolean @default(false)

  @@index([userId, isComplete])
}

model SupportCharacter {
  partyId     String
  characterId String

  party     Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  character UserCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // 1 to 10
  slot Int

  @@id([partyId, characterId])
  @@unique([partyId, slot])
}

model PlayableCharacter {
  partyId     String
  characterId String

  party     Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  character UserCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // 1 to 2
  slot Int

  supportPercentage Int

  @@id([partyId, characterId])
  @@unique([partyId, slot])
}

// -------------------------------------------------------------------------------------
/**
 * Model UserMedal
 * Contains information specific to the user about his medals and its traits.
 * isOwned determines if user already owns the medal or if it is apart of a set that he is building
 */

// ------------------------------------------------------------------------------------- 
model UserMedal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  medalId String
  medal   Medal  @relation(fields: [medalId], references: [id], onDelete: Restrict)

  // TRAITS
  traits MedalTrait[]

  medalSets MedalSetSlot[]

  isOwned Boolean @default(true)

  @@index([userId, isOwned])
}

// -------------------------------------------------------------------------------------
/**
 * Model MedalTrait
 * Contains information specific to the trait of a medal.
 * isLocked determines if user already has the trait applied to the medal or if it is apart of a set that he is building
 */

// ------------------------------------------------------------------------------------- 
model MedalTrait {
  id         String  @id @default(cuid())
  trait      String
  value      Float
  constraint String?
  // 1 to 3
  slot       Int

  medalId String
  medal   UserMedal @relation(fields: [medalId], references: [id], onDelete: Cascade)

  isLocked Boolean @default(false)

  @@unique([medalId, slot])
}

// -------------------------------------------------------------------------------------
/**
 * Model MedalSet
 * Contains information specific to the user about his medals sets including:
 * - name
 * - medals
 * - isComplete: If set is already owned or if there are things missing in the set like a medal or a medal trait
 */

// ------------------------------------------------------------------------------------- 
model MedalSet {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  character MedalSetCharacter[]

  medals MedalSetSlot[]

  isComplete Boolean @default(false)

  @@index([userId, isComplete])
}

model MedalSetSlot {
  medalId String
  medal   UserMedal @relation(fields: [medalId], references: [id], onDelete: Cascade)

  setId String
  set   MedalSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  // 1 to 3
  slot Int

  @@id([medalId, setId])
  @@unique([setId, slot])
}

model MedalSetCharacter {
  medalSetId String
  medalSet   MedalSet @relation(fields: [medalSetId], references: [id], onDelete: Cascade)

  characterId String
  character   UserCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([medalSetId, characterId])
}

// -------------------------------------------------------------------------------------
/**
 * Public avaiable information datatables
 */
// ------------------------------------------------------------------------------------- 

// -------------------------------------------------------------------------------------
/**
 * Model Character
 * Contains essencial information for a one piece bounty rush character:
 * - base element: Red, Blue, Green, Dark or Light
 * - base class: Attacker, Defender, Runner
 * - type: Transform, ElementChange, ClassChange, SkillTransform, CharacterSwap
 * - base Size: Normal, Small, Giant
 * - BaseGrade: 2Star, 3Star, 4Star
 * - Four star type: Step up, Bounty Fest, Extreme
 * - Rarity: Free, Limited, None
 * - tags: Tags applied to that character
 * - Bounty Colours: Array of images for bounty colours
 * - gameId: Game associates an ID for each character, normaly an autoincrement integer since the first chatacter, usefull to map to its medals and images. Store in String
 * - nameId: Name, game likes to group all luffy, zoro etc
 * - traits: all trait related information (characters, unlockable traits, size trait, and boost trait)
 * - characterStates: all character states associated to character
 * - asset: name of assets images of character
 * - Medals: all medals associated to character, normal character medal, or ranking character medal
 */
// ------------------------------------------------------------------------------------- 

model Character {
  id String @id @default(cuid())

  // General Character information
  name            String
  charDescription String?
  gameId          String   @unique
  nameId          String
  dateAdded       DateTime

  assetLarge String
  assetCard  String

  // Mechanics information
  type        String[]
  mainElement Element
  mainClass   Class
  mainSize    Size     @default(NORMAL)

  baseGrade    BaseGrade              @default(FOUR_STAR)
  fourStarType FourStarType?
  colab        Boolean                @default(false) 
  teamBoost    TeamBoost
  tags         CharacterTagRelation[]

  // Bounty colours
  bountyColours String[]

  //traits
  sizeTraits            String[]
  characterTraits       String[]
  traits1               String[]
  traits2               String[]
  boostTrait            String[]
  inflictsStatusEffect  String[]
  nullifiesStatusEffect String[]
  selfStatusEffect      String[]

  // character states - base and others (convert to giant, zoan version, switch character, element/class change, etc.. )
  characterStates CharacterState[]

  // medals that can be crafted using this character fragments
  medals Medal[]

  owners UserCharacter[]

  medalSetEvaluation     Json?
  partySupportEvaluation Json?
  playStyleEvaluation    Json?

  @@index([name])
  @@index([mainClass])
  @@index([mainElement])
}

// -------------------------------------------------------------------------------------
/**
 * Model Skill
 * Contains essencial information for a one piece bounty rush skill:
 * - Essencials: name, descriptions and effect
 * - slot: represents skill 1 or  skill 2. Open to more if devs one day decide to add more skills (unlikely)
 * - skillTransform: false (base form of skill), true (transformed skill of corresponding slot)
 * - cooldown: Skill cooldown in seconds
 * - asset: asset of skill
 */
// ------------------------------------------------------------------------------------- 
model Skill {
  name        String
  id          String   @id @default(cuid())
  description String[]
  effect      String[]

  characterStateId String
  characterState   CharacterState @relation(fields: [characterStateId], references: [id], onDelete: Cascade)

  asset String

  slot           Int
  skillTransform Boolean @default(false)
  cooldown       Int

  type                 String[]
  inflictsStatusEffect String[]
  selfStatusEffect     String[]

  @@unique([characterStateId, slot, skillTransform])
}

// -------------------------------------------------------------------------------------
/**
 * Model CharacterState
 * Contains essencial information for:
 * - state exclusive traits
 * - skills: Slots 1 and 2 (if chatacter SkillTransform, one/both skill slots can have transform variant)
 * - name of state and basic information of character state like class, element and size
 */
// ------------------------------------------------------------------------------------- 
model CharacterState {
  id     String  @id @default(cuid())
  name   String
  isBase Boolean @default(false)

  overrideBaseElement Element?
  overrideBaseClass   Class?
  overrideBaseSize    Size?

  stateTraits String[]
  sizeTraits  String[]

  // skills
  skills Skill[]

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, name])
}

// -------------------------------------------------------------------------------------
/**
 * Model CharacterTags
 * Contains essencial information for:
 * - name: Tag name
 */
// ------------------------------------------------------------------------------------- 

model CharacterTag {
  id   String @id @default(cuid())
  name String @unique

  characters CharacterTagRelation[]
}

model CharacterTagRelation {
  characterId String
  tagId       String

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       CharacterTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
  @@index([tagId])
}

// -------------------------------------------------------------------------------------
/**
 * Model Medal
 * Contains essencial information for a one piece bounty rush character:
 * - name: Name of medal
 * - gameId: Game associates an ID for each character, normaly an autoincrement integer since the first chatacter, usefull to map to its medals and images. Store in string
 * - uniqueTrait: entire text of the uniqueTrait
 * - type: Character or Event  or Character Ranking medal
 * - uniqueTraitConstraints: when uniqueTrait activates, can have multiple constraints
 * - uniqueTraits: Wich trait are boosted or applied, can have multiple
 * - value: by ammount, percentage (13%, 20%, etc..)
 * - asset: name of image asset
 */
// ------------------------------------------------------------------------------------- 

model Medal {
  id String @id @default(cuid())

  gameId String    @unique
  name   String
  type   MedalType

  asset String

  uniqueTraitDescription String
  uniqueTraitConstraints UniqueTraitConstraintRelation[]
  uniqueTraits           UniqueTraitRelation[]

  tags MedalTagRelation[]

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  users UserMedal[]

  @@index([type])
}

// -------------------------------------------------------------------------------------
/**
 * Model UniqueTraitConstraint
 * Contains essencial information for a medal unique trait constraint:
 * - description: Entire constraint of unique trait for print purposes exactly like game shows
 * - constraint: What is the constraint applied
 * - value: value associated with constraint if exists, ex: Hp > 90%
 * - effect:
 */
// ------------------------------------------------------------------------------------- 

model UniqueTraitConstraint {
  description  String  @id
  constraint   String
  value        Float?
  tag          String?
  statusEffect String?

  medals UniqueTraitConstraintRelation[]
}

model UniqueTraitConstraintRelation {
  medalId      String
  constraintId String

  medal      Medal                 @relation(fields: [medalId], references: [id], onDelete: Cascade)
  constraint UniqueTraitConstraint @relation(fields: [constraintId], references: [description], onDelete: Cascade)

  @@id([medalId, constraintId])
  @@index([constraintId])
}

// -------------------------------------------------------------------------------------
/**
 * Model UniqueTrait
 * Contains essencial information for a medal unique trait:
 * - description: Entire unique trait for print purposes exactly like game shows
 * - trait: What is the trait applied
 * - value: value associated with constraint if exists, ex: Skill 1 CD by 13%
 * - time: value for how many seconds its activated
 */
// ------------------------------------------------------------------------------------- 

model UniqueTrait {
  description  String  @id
  trait        String
  value        Float?
  time         Int?
  statusEffect String?

  medals UniqueTraitRelation[]
}

model UniqueTraitRelation {
  medalId       String
  uniqueTraitId String

  medal       Medal       @relation(fields: [medalId], references: [id], onDelete: Cascade)
  uniqueTrait UniqueTrait @relation(fields: [uniqueTraitId], references: [description], onDelete: Cascade)

  @@id([medalId, uniqueTraitId])
  @@index([uniqueTraitId])
}

// -------------------------------------------------------------------------------------
/**
 * Model MedalTags
 * Contains essencial information for:
 * - name: Tag name
 */
// ------------------------------------------------------------------------------------- 

model MedalTag {
  id   String @id @default(cuid())
  name String @unique

  medals MedalTagRelation[]
}

model MedalTagRelation {
  medalId String
  tagId   String

  medal Medal    @relation(fields: [medalId], references: [id], onDelete: Cascade)
  tag   MedalTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([medalId, tagId])
  @@index([tagId])
}
